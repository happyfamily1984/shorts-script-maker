{
  "version": "0.6-partial",
  "verified": false,
  "note": "홈 '창작 시작'은 스크린샷으로, 만들기 화면은 2026-11-26 화면 기록(kling.ai.video.chat)으로 확인: 사진 추가 id kling_omni_asset_add, 모드 '비디오 생성·4.0'(omni_edit_preview_cur_model), 길이·화질 omni_edit_ratio_value, 생성 버튼 id omni_edit_preview_submit(글자 없이 크레딧 숫자만). 사진 고르기 화면, 생성 뒤 애셋 화면은 아직 추측. 2026-11-26 기록 3: '창작 시작' 뒤 화면('기본 창작')은 입력칸이 접힌 상태(omni_edit_preview_text)라 눌러서 펼쳐야 '+'와 프롬프트 칸이 나온다. 같은 화면 위쪽에 작품 목록('작품 없음')이 있다. 기록 4: 클링이 이미 '기본 창작' 화면에서 열리면 '창작 시작'이 없다. 만들기 화면 표시는 id omni_edit_preview_submit(접힘·펼침 모두 있음).",
  "package": "kling.ai.video.chat",
  "after": 900,
  "start": [
    {
      "do": "launch",
      "say": "클링 앱 여는 중"
    },
    {
      "do": "wait",
      "ms": 3500
    },
    {
      "do": "unless",
      "say": "만들기 화면인지 확인",
      "find": {
        "id": "omni_edit_preview_submit"
      },
      "timeout": 2500,
      "steps": [
        {
          "do": "click",
          "say": "창작 시작 누르기",
          "find": {
            "any": [
              "창작 시작",
              "Create",
              "Start creating"
            ]
          },
          "timeout": 4000,
          "optional": true
        },
        {
          "do": "wait",
          "ms": 2000
        },
        {
          "do": "unless",
          "say": "만들기 화면인지 확인",
          "find": {
            "id": "omni_edit_preview_submit"
          },
          "timeout": 2000,
          "steps": [
            {
              "do": "back",
              "say": "이전 화면으로"
            },
            {
              "do": "wait",
              "ms": 1500
            },
            {
              "do": "click",
              "say": "창작 시작 누르기",
              "find": {
                "any": [
                  "창작 시작",
                  "Create",
                  "Start creating"
                ]
              },
              "timeout": 4000,
              "optional": true
            },
            {
              "do": "wait",
              "ms": 2000
            },
            {
              "do": "unless",
              "say": "만들기 화면인지 확인",
              "find": {
                "id": "omni_edit_preview_submit"
              },
              "timeout": 2000,
              "steps": [
                {
                  "do": "back",
                  "say": "이전 화면으로"
                },
                {
                  "do": "wait",
                  "ms": 1500
                },
                {
                  "do": "click",
                  "say": "창작 시작 누르기",
                  "find": {
                    "any": [
                      "창작 시작",
                      "Create",
                      "Start creating"
                    ]
                  },
                  "timeout": 6000
                },
                {
                  "do": "wait",
                  "ms": 2000
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "shot": [
    {
      "do": "unless",
      "say": "동영상 모드인지 확인",
      "find": {
        "any": [
          "동영상 생성",
          "영상 생성",
          "비디오 생성",
          "Video Generation",
          "AI Video"
        ]
      },
      "timeout": 1500,
      "steps": [
        {
          "do": "click",
          "say": "모드 메뉴 열기",
          "find": {
            "any": [
              "이미지 생성",
              "Image Generation"
            ]
          },
          "timeout": 5000
        },
        {
          "do": "wait",
          "ms": 1200
        },
        {
          "do": "click",
          "say": "동영상 생성 고르기",
          "find": {
            "any": [
              "동영상 생성",
              "영상 생성",
              "비디오 생성",
              "동영상",
              "Video"
            ]
          },
          "timeout": 5000
        },
        {
          "do": "wait",
          "ms": 1500
        }
      ]
    },
    {
      "do": "unless",
      "say": "입력칸 펼치기",
      "find": {
        "id": "kling_omni_asset_add"
      },
      "timeout": 1500,
      "steps": [
        {
          "do": "click",
          "say": "입력칸 누르기",
          "find": {
            "id": "omni_edit_preview_text"
          },
          "orTap": {
            "x": 0.5,
            "y": 0.885
          },
          "timeout": 5000
        },
        {
          "do": "wait",
          "ms": 1500
        }
      ]
    },
    {
      "do": "click",
      "say": "사진 넣기(+) 누르기",
      "find": {
        "id": "kling_omni_asset_add"
      },
      "orTap": {
        "x": 0.13,
        "y": 0.336
      },
      "timeout": 3000,
      "if": "imageCount"
    },
    {
      "do": "wait",
      "ms": 1800,
      "if": "imageCount"
    },
    {
      "do": "clickEach",
      "say": "방금 저장한 사진 고르기",
      "find": {
        "cls": "ImageView",
        "area": [
          0,
          0.12,
          1,
          0.95
        ],
        "minW": 60
      },
      "count": "${imageCount}",
      "timeout": 8000,
      "if": "imageCount"
    },
    {
      "do": "click",
      "say": "사진 선택 마치기",
      "find": {
        "any": [
          "=완료",
          "=추가",
          "=확인",
          "=선택",
          "=Done",
          "=Add",
          "=Select",
          "=OK"
        ]
      },
      "timeout": 5000,
      "optional": true,
      "if": "imageCount"
    },
    {
      "do": "wait",
      "ms": 2500,
      "if": "imageCount"
    },
    {
      "do": "setText",
      "say": "프롬프트 입력",
      "find": {
        "editable": true,
        "pkg": "kling.ai.video.chat"
      },
      "value": "${prompt}",
      "timeout": 8000
    },
    {
      "do": "click",
      "say": "생성 누르기",
      "find": {
        "id": "omni_edit_preview_submit"
      },
      "timeout": 6000,
      "if": "autoGenerate",
      "orTap": {
        "x": 0.85,
        "y": 0.586
      }
    },
    {
      "do": "wait",
      "ms": 3500,
      "if": "autoGenerate"
    }
  ],
  "between": [
    {
      "do": "wait",
      "ms": 1500
    }
  ],
  "end": [],
  "collectStart": [
    {
      "do": "wait",
      "ms": 2000
    },
    {
      "do": "click",
      "say": "애셋 화면 열기",
      "find": {
        "any": [
          "=애셋",
          "=Assets",
          "=내 작품",
          "=My Creations"
        ]
      },
      "timeout": 4000,
      "optional": true
    },
    {
      "do": "wait",
      "ms": 2500
    },
    {
      "do": "waitGone",
      "say": "영상이 모두 만들어지길 기다리는 중 (몇 분 걸립니다)",
      "find": {
        "any": [
          "생성 중",
          "대기 중",
          "Generating",
          "Queued",
          "Processing"
        ]
      },
      "timeout": 1200000
    }
  ],
  "collect": [
    {
      "do": "click",
      "say": "${shot}번째 영상 열기",
      "find": {
        "cls": "ImageView",
        "minW": 120,
        "area": [
          0,
          0.12,
          1,
          0.9
        ],
        "index": "${ri}"
      },
      "timeout": 8000
    },
    {
      "do": "wait",
      "ms": 2000
    },
    {
      "do": "click",
      "say": "${shot}번째 영상 내려받기",
      "find": {
        "any": [
          "다운로드",
          "저장",
          "Download",
          "Save"
        ]
      },
      "timeout": 8000
    },
    {
      "do": "wait",
      "ms": 4000
    },
    {
      "do": "click",
      "say": "워터마크 없이 받기 고르기",
      "find": {
        "any": [
          "워터마크 없음",
          "워터마크 없이",
          "Without watermark",
          "No watermark"
        ]
      },
      "timeout": 2500,
      "optional": true
    },
    {
      "do": "wait",
      "ms": 3000
    },
    {
      "do": "back",
      "say": "목록으로",
      "optional": true
    },
    {
      "do": "wait",
      "ms": 1500
    }
  ],
  "collectEnd": [
    {
      "do": "returnApp",
      "say": "숏드라마 메이커로 돌아가 영상 합치기"
    }
  ]
}