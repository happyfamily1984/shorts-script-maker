{
  "version": "0.2-partial",
  "verified": false,
  "note": "홈 '창작 시작'과 만들기 화면(+, 프롬프트 칸, 모드 '이미지 생성·4.0', '생성')은 사용자 스크린샷으로 확인함. 모드 메뉴, 사진 고르기 화면, 생성 뒤 화면은 아직 추측.",
  "package": "",
  "after": 900,
  "start": [
    { "do": "launch", "say": "클링 앱 여는 중" },
    { "do": "wait", "ms": 3500 },
    { "do": "click", "say": "창작 시작 누르기", "find": { "any": ["창작 시작", "Create", "Start creating"] }, "timeout": 10000 },
    { "do": "wait", "ms": 2000 }
  ],
  "shot": [
    { "do": "unless", "say": "동영상 모드인지 확인", "find": { "any": ["동영상 생성", "영상 생성", "비디오 생성", "Video Generation", "AI Video"] }, "timeout": 1500, "steps": [
      { "do": "click", "say": "모드 메뉴 열기", "find": { "any": ["이미지 생성", "Image Generation"] }, "timeout": 5000 },
      { "do": "wait", "ms": 1200 },
      { "do": "click", "say": "동영상 생성 고르기", "find": { "any": ["동영상 생성", "영상 생성", "비디오 생성", "동영상", "Video"] }, "timeout": 5000 },
      { "do": "wait", "ms": 1500 }
    ] },
    { "do": "click", "say": "사진 넣기(+) 누르기", "find": { "any": ["=+", "업로드", "이미지 추가", "참고 이미지", "Upload", "Add"] }, "orTap": { "x": 0.13, "y": 0.336 }, "timeout": 3000, "if": "imageCount" },
    { "do": "wait", "ms": 1800, "if": "imageCount" },
    { "do": "clickEach", "say": "방금 저장한 사진 고르기", "find": { "cls": "ImageView", "area": [0, 0.12, 1, 0.95], "minW": 60 }, "count": "${imageCount}", "timeout": 8000, "if": "imageCount" },
    { "do": "click", "say": "사진 선택 마치기", "find": { "any": ["=완료", "=추가", "=확인", "=선택", "=Done", "=Add", "=Select", "=OK"] }, "timeout": 5000, "optional": true, "if": "imageCount" },
    { "do": "wait", "ms": 2500, "if": "imageCount" },
    { "do": "setText", "say": "프롬프트 입력", "find": { "editable": true }, "value": "${prompt}", "timeout": 8000 },
    { "do": "click", "say": "생성 누르기", "find": { "any": ["=생성", "=생성하기", "=Generate"] }, "timeout": 6000, "if": "autoGenerate" },
    { "do": "wait", "ms": 3500, "if": "autoGenerate" }
  ],
  "between": [
    { "do": "wait", "ms": 1500 }
  ],
  "end": []
}
