{
  "version": "0.5",
  "verified": false,
  "note": "2026-11-26 사용자 화면 기록(ai.x.grok) 두 장으로 확인: 채팅 화면(입력칸 id chat_text_input, '새 채팅 시작하기', 결과 이미지 'Generated Image'), 이미지 화면('닫기', '다운로드', '공유'). 그록이 이미지 화면에서 열려도 닫고 채팅으로 돌아간다. 0.4: 장면 이미지 여러 장을 한 번에 만들 수 있게 샷마다 새 채팅을 연다. 0.5: 프롬프트가 길면 결과 이미지가 화면 밖에 있어 못 찾음 → 기다리는 동안 '아래로 스크롤' 버튼·위로 쓸기로 맨 아래를 보이게 한다.",
  "package": "ai.x.grok",
  "after": 900,
  "start": [
    {
      "do": "launch",
      "say": "그록 앱 여는 중"
    },
    {
      "do": "wait",
      "ms": 3500
    },
    {
      "do": "unless",
      "say": "채팅 화면 확인",
      "find": {
        "id": "chat_text_input"
      },
      "timeout": 2500,
      "steps": [
        {
          "do": "click",
          "say": "이미지 화면 닫기",
          "find": {
            "any": [
              "=닫기",
              "=Close"
            ]
          },
          "timeout": 2000,
          "optional": true
        },
        {
          "do": "wait",
          "ms": 1200
        },
        {
          "do": "unless",
          "say": "채팅 화면 확인",
          "find": {
            "id": "chat_text_input"
          },
          "timeout": 2000,
          "steps": [
            {
              "do": "back",
              "say": "이전 화면으로"
            },
            {
              "do": "wait",
              "ms": 1200
            }
          ]
        }
      ]
    },
    {
      "do": "wait",
      "ms": 1500
    }
  ],
  "shot": [
    {
      "do": "click",
      "say": "새 채팅 열기",
      "find": {
        "any": [
          "새 채팅 시작하기",
          "새 채팅",
          "New chat",
          "New Chat"
        ]
      },
      "timeout": 4000,
      "optional": true
    },
    {
      "do": "wait",
      "ms": 1500
    },
    {
      "do": "setText",
      "say": "이미지 프롬프트 입력",
      "find": {
        "id": "chat_text_input"
      },
      "value": "${prompt}",
      "timeout": 10000
    },
    {
      "do": "wait",
      "ms": 600
    },
    {
      "do": "click",
      "say": "보내기 누르기",
      "find": {
        "any": [
          "보내기",
          "전송",
          "Send",
          "Submit"
        ]
      },
      "timeout": 5000
    },
    {
      "do": "wait",
      "ms": 4000
    },
    {
      "do": "repeat",
      "say": "이미지가 만들어지길 기다리는 중",
      "count": "40",
      "steps": [
        {
          "do": "unless",
          "say": "이미지가 만들어지길 기다리는 중",
          "find": {
            "desc": "Generated Image"
          },
          "timeout": 3500,
          "steps": [
            {
              "do": "click",
              "say": "아래로 스크롤",
              "find": {
                "any": [
                  "아래로 스크롤",
                  "Scroll to bottom"
                ]
              },
              "timeout": 500,
              "optional": true
            },
            {
              "do": "swipe",
              "say": "아래로 내리기",
              "x1": 0.5,
              "y1": 0.62,
              "x2": 0.5,
              "y2": 0.3,
              "ms": 300,
              "optional": true
            }
          ]
        }
      ]
    },
    {
      "do": "waitFor",
      "say": "이미지 확인",
      "find": {
        "desc": "Generated Image"
      },
      "timeout": 5000,
      "fail": "그록 이미지가 3분 안에 나오지 않았습니다. 그록에서 생성이 됐는지 확인하세요"
    },
    {
      "do": "wait",
      "ms": 4000
    },
    {
      "do": "click",
      "say": "만들어진 이미지 열기",
      "find": {
        "desc": "Generated Image",
        "index": -1
      },
      "timeout": 5000
    },
    {
      "do": "wait",
      "ms": 2000
    },
    {
      "do": "click",
      "say": "이미지 다운로드",
      "find": {
        "any": [
          "=다운로드",
          "=Download",
          "=저장",
          "=Save"
        ]
      },
      "timeout": 8000
    },
    {
      "do": "wait",
      "ms": 3500
    },
    {
      "do": "click",
      "say": "이미지 화면 닫기",
      "find": {
        "any": [
          "=닫기",
          "=Close"
        ]
      },
      "timeout": 3000,
      "optional": true
    },
    {
      "do": "wait",
      "ms": 800
    }
  ],
  "between": [],
  "end": [
    {
      "do": "returnApp",
      "say": "숏드라마 메이커로 돌아가기"
    }
  ]
}