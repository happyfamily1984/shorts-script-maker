{
  "version": "0.1-guess",
  "verified": false,
  "note": "그록 앱 화면을 보지 않고 쓴 추측 순서. 화면 기록 파일을 받으면 실제 버튼에 맞춰 고친다.",
  "package": "",
  "after": 900,
  "start": [
    { "do": "launch", "say": "그록 앱 여는 중" },
    { "do": "wait", "ms": 3500 },
    { "do": "click", "say": "새 대화 열기", "find": { "any": ["새 대화", "새 채팅", "New chat", "New Chat"] }, "timeout": 4000, "optional": true },
    { "do": "wait", "ms": 1200 }
  ],
  "shot": [
    { "do": "setText", "say": "이미지 프롬프트 입력", "find": { "editable": true }, "value": "${prompt}", "timeout": 10000 },
    { "do": "click", "say": "보내기 누르기", "find": { "any": ["보내기", "전송", "Send", "Submit"] }, "timeout": 5000 },
    { "do": "wait", "ms": 4000 },
    { "do": "waitFor", "say": "이미지가 만들어지길 기다리는 중", "find": { "cls": "ImageView", "minW": 180, "area": [0, 0.08, 1, 0.92] }, "timeout": 120000 },
    { "do": "wait", "ms": 2500 },
    { "do": "click", "say": "만들어진 이미지 열기", "find": { "cls": "ImageView", "minW": 180, "area": [0, 0.08, 1, 0.92], "index": -1 }, "timeout": 5000 },
    { "do": "wait", "ms": 1500 },
    { "do": "click", "say": "이미지 저장", "find": { "any": ["다운로드", "저장", "Download", "Save"] }, "timeout": 6000 },
    { "do": "wait", "ms": 3000 }
  ],
  "between": [],
  "end": [
    { "do": "returnApp", "say": "숏드라마 메이커로 돌아가기" }
  ]
}
