{
  "version": "0.3",
  "verified": false,
  "note": "2026-11-26 사용자 화면 기록(ai.x.grok) 두 장으로 확인: 채팅 화면(입력칸 id chat_text_input, '새 채팅 시작하기', 결과 이미지 'Generated Image'), 이미지 화면('닫기', '다운로드', '공유'). 그록이 이미지 화면에서 열려도 닫고 채팅으로 돌아간다.",
  "package": "ai.x.grok",
  "after": 900,
  "start": [
    {
      "do": "launch",
      "say": "그록 앱 여는 중"
    },
    {
      "do": "wait",
      "ms": 3500
    },
    {
      "do": "unless",
      "say": "채팅 화면 확인",
      "find": {
        "id": "chat_text_input"
      },
      "timeout": 2500,
      "steps": [
        {
          "do": "click",
          "say": "이미지 화면 닫기",
          "find": {
            "any": [
              "=닫기",
              "=Close"
            ]
          },
          "timeout": 2000,
          "optional": true
        },
        {
          "do": "wait",
          "ms": 1200
        },
        {
          "do": "unless",
          "say": "채팅 화면 확인",
          "find": {
            "id": "chat_text_input"
          },
          "timeout": 2000,
          "steps": [
            {
              "do": "back",
              "say": "이전 화면으로"
            },
            {
              "do": "wait",
              "ms": 1200
            }
          ]
        }
      ]
    },
    {
      "do": "click",
      "say": "새 채팅 열기",
      "find": {
        "any": [
          "새 채팅 시작하기",
          "새 채팅",
          "New chat",
          "New Chat"
        ]
      },
      "timeout": 4000,
      "optional": true
    },
    {
      "do": "wait",
      "ms": 1500
    }
  ],
  "shot": [
    {
      "do": "setText",
      "say": "이미지 프롬프트 입력",
      "find": {
        "id": "chat_text_input"
      },
      "value": "${prompt}",
      "timeout": 10000
    },
    {
      "do": "wait",
      "ms": 600
    },
    {
      "do": "click",
      "say": "보내기 누르기",
      "find": {
        "any": [
          "보내기",
          "전송",
          "Send",
          "Submit"
        ]
      },
      "timeout": 5000
    },
    {
      "do": "wait",
      "ms": 4000
    },
    {
      "do": "waitFor",
      "say": "이미지가 만들어지길 기다리는 중",
      "find": {
        "desc": "Generated Image"
      },
      "timeout": 150000
    },
    {
      "do": "wait",
      "ms": 4000
    },
    {
      "do": "click",
      "say": "만들어진 이미지 열기",
      "find": {
        "desc": "Generated Image",
        "index": -1
      },
      "timeout": 5000
    },
    {
      "do": "wait",
      "ms": 2000
    },
    {
      "do": "click",
      "say": "이미지 다운로드",
      "find": {
        "any": [
          "=다운로드",
          "=Download",
          "=저장",
          "=Save"
        ]
      },
      "timeout": 8000
    },
    {
      "do": "wait",
      "ms": 3500
    },
    {
      "do": "click",
      "say": "이미지 화면 닫기",
      "find": {
        "any": [
          "=닫기",
          "=Close"
        ]
      },
      "timeout": 3000,
      "optional": true
    },
    {
      "do": "wait",
      "ms": 800
    }
  ],
  "between": [],
  "end": [
    {
      "do": "returnApp",
      "say": "숏드라마 메이커로 돌아가기"
    }
  ]
}